{
  "name": "first-customers",
  "kind": "extension-pack",
  "source": {
    "manifest": "skills/first-customers/.source.json"
  },
  "hosts": ["claude", "codex"],
  "runtime": {
    "required": false,
    "dependencies": []
  },
  "capabilities": ["sales", "customers", "go-to-market"],
  "workflow_integration": {
    "default_mode": "standalone",
    "can_attach_to_runner": false
  },
  "docs": {
    "zh_cn": "skills/first-customers/SKILL.md"
  },
  "security": {
    "network_required": false,
    "writes_outside_repo": false
  }
}
