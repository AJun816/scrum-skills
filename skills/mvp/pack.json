{
  "name": "mvp",
  "kind": "extension-pack",
  "source": {
    "manifest": "skills/mvp/.source.json"
  },
  "hosts": ["claude", "codex"],
  "runtime": {
    "required": false,
    "dependencies": []
  },
  "capabilities": ["mvp", "scope", "prioritization"],
  "workflow_integration": {
    "default_mode": "standalone",
    "can_attach_to_runner": false
  },
  "docs": {
    "zh_cn": "skills/mvp/SKILL.md"
  },
  "security": {
    "network_required": false,
    "writes_outside_repo": false
  }
}
