{
  "name": "company-values",
  "kind": "extension-pack",
  "source": {
    "manifest": "skills/company-values/.source.json"
  },
  "hosts": ["claude", "codex"],
  "runtime": {
    "required": false,
    "dependencies": []
  },
  "capabilities": ["culture", "values", "hiring"],
  "workflow_integration": {
    "default_mode": "standalone",
    "can_attach_to_runner": false
  },
  "docs": {
    "zh_cn": "skills/company-values/SKILL.md"
  },
  "security": {
    "network_required": false,
    "writes_outside_repo": false
  }
}
