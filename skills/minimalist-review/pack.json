{
  "name": "minimalist-review",
  "kind": "extension-pack",
  "source": {
    "manifest": "skills/minimalist-review/.source.json"
  },
  "hosts": ["claude", "codex"],
  "runtime": {
    "required": false,
    "dependencies": []
  },
  "capabilities": ["review", "strategy", "decision-making"],
  "workflow_integration": {
    "default_mode": "standalone",
    "can_attach_to_runner": false
  },
  "docs": {
    "zh_cn": "skills/minimalist-review/SKILL.md"
  },
  "security": {
    "network_required": false,
    "writes_outside_repo": false
  }
}
