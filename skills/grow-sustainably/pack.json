{
  "name": "grow-sustainably",
  "kind": "extension-pack",
  "source": {
    "manifest": "skills/grow-sustainably/.source.json"
  },
  "hosts": ["claude", "codex"],
  "runtime": {
    "required": false,
    "dependencies": []
  },
  "capabilities": ["growth", "profitability", "operations"],
  "workflow_integration": {
    "default_mode": "standalone",
    "can_attach_to_runner": false
  },
  "docs": {
    "zh_cn": "skills/grow-sustainably/SKILL.md"
  },
  "security": {
    "network_required": false,
    "writes_outside_repo": false
  }
}
